# Variaveis lidas pelo DOCKER COMPOSE (nao pelo Laravel) ao subir a stack de
# producao. A config da aplicacao fica em .env.production.
#
#   cp .env.deploy.example .env.deploy   # e preencha
#   docker compose -f docker-compose.prod.yml --env-file .env.deploy up -d --build
#
# Precisa existir separado do .env.production porque o Compose interpola estas
# variaveis antes de qualquer container subir - inclusive para criar o banco.

# Credenciais do MySQL. DB_PASSWORD tem que bater com o do .env.production.
DB_ROOT_PASSWORD=
DB_DATABASE=orchestra
DB_USERNAME=orchestra
DB_PASSWORD=

# Portas expostas no host
API_PORT=8080
FRONTEND_PORT=8081

# Assado no bundle do frontend em tempo de build (o Vite resolve
# import.meta.env no build, nao no runtime).
VITE_API_URL=http://localhost:8080/api
